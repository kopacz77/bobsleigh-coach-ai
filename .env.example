# ============================================================================
# BOBSLEIGH COACH AI — ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to `.env` and adjust as needed. The defaults below work
# out-of-the-box with `docker compose up` (zero external services required).
# ============================================================================


# ---- Database ---------------------------------------------------------------
# Local Docker Postgres URL. Used by the FastAPI backend via SQLAlchemy.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bobsleigh


# ---- Backend ----------------------------------------------------------------
# `development` enables verbose logging and stack traces.
ENVIRONMENT=development

# Comma-separated list of allowed CORS origins for the FastAPI app.
CORS_ORIGINS=http://localhost:3000

# Required by FastAPI session middleware. ANY value works locally; rotate
# this in production.
SECRET_KEY=dev-secret-key-not-for-production


# ---- Auth (backend) ---------------------------------------------------------
# AUTH_PROVIDER picks the auth backend:
#   * "dev"      -- accepts any Bearer token; returns the DEV_USER_* identity
#   * "supabase" -- validates against a live Supabase project (production)
AUTH_PROVIDER=dev

# These three define the static dev user used by AUTH_PROVIDER=dev. Must
# match a public.users row in the local Postgres (seeded via
# backend/sql/init/02-seed-users.sql).
#
#   coach role  -> 00000000-0000-0000-0000-000000000001 / coach@dev.local
#   athlete role -> 00000000-0000-0000-0000-000000000002 / josh@dev.local
DEV_USER_ID=00000000-0000-0000-0000-000000000001
DEV_USER_EMAIL=coach@dev.local
DEV_USER_ROLE=coach


# ---- Frontend ---------------------------------------------------------------
# Backend API base URL the Next.js client talks to.
NEXT_PUBLIC_API_URL=http://localhost:8000

# NEXT_PUBLIC_AUTH_MODE controls client-side auth:
#   * "dev"      -- skip Supabase; use a stub session pointing at the dev user
#   * "supabase" -- use the Supabase JS SDK with the *_SUPABASE_* vars below
NEXT_PUBLIC_AUTH_MODE=dev


# ---- Optional: Supabase (only when AUTH_PROVIDER=supabase) ------------------
# Leave these empty for local dev; populate them only when switching to
# a live Supabase project.
# SUPABASE_URL=
# SUPABASE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
